{
  "aggregation": [],
  "materialisation": {
    "intent": "table",
    "publication_mode": "atomic",
    "strategy": "swap",
    "unique_key": []
  },
  "product": "ecommerce.product",
  "relations": {
    "auxiliary": [
      "ecommerce.product__checked_post",
      "ecommerce.product__checked_pre",
      "ecommerce.product__current",
      "ecommerce.product__pending_keys",
      "ecommerce.product__quarantine_post",
      "ecommerce.product__quarantine_pre",
      "ecommerce.product__resolution",
      "ecommerce.product__sla"
    ],
    "published": [
      "ecommerce.product"
    ]
  },
  "retry_policy": {
    "backoff": "fixed",
    "max_retries": 2
  },
  "run_boundary": {
    "checkpoint": true,
    "granularity": "step",
    "occurrences": [
      "steps[0]:batch_transfer",
      "steps[1]:data_validation",
      "steps[2]:schema_transform",
      "steps[3]:data_curation",
      "steps[4]:data_validation",
      "steps[9]:data_publish"
    ]
  },
  "schema": "ergasterion.product-runtime/v1",
  "translator": "dbt"
}
