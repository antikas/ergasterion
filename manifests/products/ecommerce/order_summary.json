{
  "aggregation": [
    {
      "grain": [
        "order_id"
      ],
      "late_arrival_policy": "recompute_period"
    }
  ],
  "materialisation": {
    "intent": "undeclared",
    "publication_mode": "incremental",
    "strategy": {
      "bigquery": "merge",
      "duckdb": "delete+insert"
    },
    "unique_key": [
      "order_id"
    ]
  },
  "product": "ecommerce.order_summary",
  "relations": {
    "auxiliary": [
      "ecommerce.order_summary__checked",
      "ecommerce.order_summary__current",
      "ecommerce.order_summary__quarantine",
      "ecommerce.order_summary__sla"
    ],
    "published": [
      "ecommerce.order_summary"
    ]
  },
  "retry_policy": {
    "backoff": "fixed",
    "max_retries": 2
  },
  "run_boundary": {
    "checkpoint": false,
    "granularity": "step",
    "occurrences": [
      "steps[0]:batch_transfer",
      "steps[1]:data_validation",
      "steps[2]:data_aggregation",
      "steps[6]:data_publish"
    ]
  },
  "schema": "ergasterion.product-runtime/v1",
  "translator": "dbt"
}
