{
  "aggregation": [
    {
      "grain": [
        "fund_business_key",
        "calendar_year"
      ],
      "late_arrival_policy": "recompute_period"
    }
  ],
  "materialisation": {
    "intent": "undeclared",
    "publication_mode": "incremental",
    "strategy": {
      "bigquery": "merge",
      "duckdb": "delete+insert"
    },
    "unique_key": [
      "fund_business_key",
      "calendar_year"
    ]
  },
  "product": "investment.fund_performance_summary",
  "relations": {
    "auxiliary": [
      "investment.fund_performance_summary__checked",
      "investment.fund_performance_summary__current",
      "investment.fund_performance_summary__filter_log",
      "investment.fund_performance_summary__prefilter",
      "investment.fund_performance_summary__quarantine",
      "investment.fund_performance_summary__sla"
    ],
    "published": [
      "investment.fund_performance_summary"
    ]
  },
  "retry_policy": {
    "backoff": "fixed",
    "max_retries": 2
  },
  "run_boundary": {
    "checkpoint": false,
    "granularity": "step",
    "occurrences": [
      "steps[0]:batch_transfer",
      "steps[1]:data_validation",
      "steps[2]:data_filtering",
      "steps[3]:data_aggregation",
      "steps[8]:data_publish"
    ]
  },
  "schema": "ergasterion.product-runtime/v1",
  "translator": "dbt"
}
