{
  "aggregation": [
    {
      "grain": [
        "gp_name_lookup_key"
      ],
      "late_arrival_policy": "recompute_period"
    }
  ],
  "materialisation": {
    "intent": "undeclared",
    "publication_mode": "incremental",
    "strategy": {
      "bigquery": "merge",
      "duckdb": "delete+insert"
    },
    "unique_key": [
      "gp_name_lookup_key"
    ]
  },
  "product": "investment.gp_name_index",
  "relations": {
    "auxiliary": [
      "investment.gp_name_index__checked_post",
      "investment.gp_name_index__checked_pre",
      "investment.gp_name_index__current",
      "investment.gp_name_index__filter_log",
      "investment.gp_name_index__prefilter",
      "investment.gp_name_index__quarantine_post",
      "investment.gp_name_index__quarantine_pre",
      "investment.gp_name_index__sla"
    ],
    "published": [
      "investment.gp_name_index"
    ]
  },
  "retry_policy": {
    "backoff": "fixed",
    "max_retries": 2
  },
  "run_boundary": {
    "checkpoint": false,
    "granularity": "step",
    "occurrences": [
      "steps[0]:batch_transfer",
      "steps[1]:data_validation",
      "steps[2]:calculated_fields",
      "steps[3]:data_filtering",
      "steps[4]:data_aggregation",
      "steps[5]:data_validation",
      "steps[10]:data_publish"
    ]
  },
  "schema": "ergasterion.product-runtime/v1",
  "translator": "dbt"
}
