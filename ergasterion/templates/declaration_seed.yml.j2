{{ header }}
source:
  name: {{ source.name }}
  display_name: {{ source.display_name }}
  system: {{ source.system | tojson }}
  priority: {{ source.priority }}  # TODO: confirm survivorship priority (lower wins ties -- see sibling declarations/*.yml for the convention this domain uses)

tables:
{%- for table in tables %}
  {{ table.name }}:
{%- if table.landing is defined %}
    description: {{ table.description | tojson }}
    landing:
      kind: source
      source_name: {{ table.landing.source_name }}
      identifier: {{ table.landing.identifier }}
      integration: {{ table.landing.integration | tojson }}
      content_encodings: {{ table.landing.content_encodings | tojson }}
      codec: {{ table.landing.codec | tojson }}
      physical_columns:
{%- for column in table.landing.physical_columns %}
        - {name: {{ column.name }}, logical_type: {{ column.logical_type | tojson }}, nullable: {{ column.nullable | tojson }}}
{%- endfor %}
    delivery:
      kind: draft
      reason: delivery_contract_required
    # TODO product -- add {product: {product_version, display_name, description, owner,
    # support, classification, access_policy_ref, retention_policy_ref}}; no importer input
    # carries ownership, support, access classification or retention -- authored judgment,
    # never guessed.
    # TODO projection -- once product is authored, add the published projection
    # ({source, name, logical_type, nullable} per column) and the delivery mode's own
    # facts (schedule, progress, timestamps, delete_strategy, record_key, quality, retry).
    # TODO domain membership -- register this (source, table) under a domains/<domain>.yml
    # bronze: block so production generation resolves a domain.
    # Only once every TODO above is filled in, flip delivery.kind to production -- see
    # docs/specifications/bronze-product-v1.md.
{%- else %}
    raw_model: {{ table.raw_model }}  # TODO: confirm the actual seed/landing table name this reads from
    description: {{ table.description | tojson }}
{%- if table.seed_tests %}
    seed_tests:
{%- for column in table.seed_tests %}
      - {name: {{ column.name }}, data_tests: {{ column.data_tests }}}
{%- endfor %}
{%- else %}
    seed_tests: []
{%- endif %}
{%- if table.model_tests %}
    model_tests:
{%- for column in table.model_tests %}
      - {name: {{ column.name }}, data_tests: {{ column.data_tests }}}
{%- endfor %}
{%- else %}
    model_tests: []
{%- endif %}
    projection:
{%- for column in table.projection %}
      - {name: {{ column.name }}, expression: {{ column.expression | tojson }}}
{%- if column.physical_type %}
      # supplier physicalType for {{ column.name }}: {{ column.physical_type }} (not compiled into the cast above -- see module docstring)
{%- endif %}
{%- endfor %}
    # TODO vault_entities -- no ODCS contract carries this; it is authored judgment, never
    # guessed. Add manually if this table's records feed a vault entity declared in this
    # domain's domains/<domain>.yml entity_configs. Worked example shape (see
    # declarations/cartivo.yml for a fully worked one):
    #   vault_entities:
    #     - name: {{ table.name }}
    #       entity: <entity_configs key>
    #       record_source: "!{{ source.display_name }}_{{ table.name | upper }}"
    #       bridge:
    #         resolutions:
    #           - alias: <alias>_resolution
    #             model: res_<entity>
    #             join_type: inner
    #             conditions:
    #               - <alias>_resolution.source_system = source.source_system
    #               - <alias>_resolution.source_id = source.<source_id_column>
    #         select:
    #           - {name: source_system, expression: source.source_system}
    #           - ...
    #         where:
    #           - <alias>_resolution.golden_<entity>_key is not null
    vault_entities: []
{%- endif %}
{% endfor %}
# TODO entity_resolution -- add a top-level `entity_resolution:` mapping only if a table
# above is vaulted against an entity that fans into a shared res_<entity> resolution
# model; see declarations/cartivo.yml's `entity_resolution:` section for the shape. No
# ODCS contract carries this either -- authored judgment.
#
# TODO canonical_mappings -- only relevant if this domain cross-validates sources against
# an external canonical model (an investment-domain-only convention today; see README
# "What this is not"). Omit entirely if this domain has none.
