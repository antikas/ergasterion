{# The one product declaration `ergasterion init` seeds a new estate with.
   Rendered by ergasterion/sync_scaffold.py from the same reference identity
   the shipped runtime binding is computed against, so a fresh estate
   validates and emits through `ergasterion emit-products` out of the box.
   Every value below is a placeholder a consumer replaces with their own. -#}
# The seeded product declaration. It is authored input, not generated output:
# edit it, rename it, or delete it once you declare products of your own.
#
# It composes the {{ profile }} profile, which the `{{ label }}` label in
# estate.yml admits, and it renders through the translator that estate.yml
# names for each of its patterns. `ergasterion emit-products --estate-root .`
# turns it into a dbt model, its schema documentation and its runtime
# manifest under models/products/ and manifests/products/.
#
# Its source is bound to a fixture relation ({{ source_relation }}), so this
# estate validates and emits before any product upstream of it exists. Once
# a product in this estate publishes the contract you want to read, drop the
# `kind`/`fixture` block and name that contract instead.
product:
  name: {{ product_name }}
  domain: {{ product_domain }}
  version: "1.0"
  layer: {{ label }}
  owner: {{ owner }}

sources:
  - contract: {{ source_contract }}
    kind: fixture
    fixture:
      relation: {{ source_relation }}
      fields:
        - {name: {{ key_field }}, type: string}
        - {name: {{ load_field }}, type: timestamp}
    expect:
      fields: [{{ key_field }}, {{ load_field }}]

steps:
  - pattern: batch_transfer
  - pattern: data_validation
    on_failure: quarantine
    error_threshold: 0.01
    rules:
      - field: {{ key_field }}
        completeness: 1.0
  - pattern: calculated_fields
    fields:
      - {name: {{ derived_field }}, type: date, expression: "CAST({{ load_field }} AS DATE)"}
  - pattern: data_contracts
  - pattern: lineage_capture
  - pattern: metadata_capture
    description: "{{ description }}"
    ownership: {{ owner }}
  - pattern: schema_publish
  - pattern: data_publish
    publication_mode: atomic

target:
  shape: declared
  contract:
    freshness: "daily by 06:00 UTC"
    access:
      classification: internal

checkpointing:
  granularity: step
  max_retries: 2
  backoff: fixed
