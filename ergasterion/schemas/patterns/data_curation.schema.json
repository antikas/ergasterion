{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ergasterion.dev/schemas/patterns/data_curation.schema.json",
  "title": "data_curation step configuration (architecture section 4)",
  "description": "Entity, resolution strategy, keys, survivorship, merge rules. 'resolution' names the ranked deterministic keys records are clustered on, the column that identifies one input record, and how many rounds of label propagation the cluster unroll runs. A probabilistic resolution adds 'scoring': the named rule that scores one candidate pair, the columns compared across the pair, the columns candidate pairs are blocked on, and the review band the score is classified into. 'survivorship' names, per column, the strategy that picks the surviving value; 'precedence' carries the inputs both strategies need -- the column naming the contributing source, the column recency is ordered by, and the declared source order. A translator that renders this pattern states which of these it requires and fails closed on a missing one.",
  "type": "object",
  "required": ["pattern", "entity", "resolution"],
  "additionalProperties": false,
  "properties": {
    "pattern": { "const": "data_curation" },
    "entity": { "type": "string", "minLength": 1 },
    "resolution": {
      "type": "object",
      "required": ["strategy", "keys"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["deterministic", "probabilistic"] },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "record_key": { "type": "string", "minLength": 1 },
        "merge_iterations": { "type": "integer", "minimum": 1 },
        "scoring": {
          "type": "object",
          "required": ["rule", "compare", "block_on", "review_band"],
          "additionalProperties": false,
          "properties": {
            "rule": { "type": "string", "minLength": 1 },
            "rule_version": { "type": "integer", "minimum": 1 },
            "compare": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "block_on": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "review_band": {
              "type": "object",
              "required": ["lower", "upper"],
              "additionalProperties": false,
              "properties": {
                "lower": { "type": "number", "minimum": 0, "maximum": 1 },
                "upper": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "survivorship": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "precedence": {
      "type": "object",
      "required": ["source_column", "recency_column", "source_priority"],
      "additionalProperties": false,
      "properties": {
        "source_column": { "type": "string", "minLength": 1 },
        "recency_column": { "type": "string", "minLength": 1 },
        "source_priority": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "merge_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
