# docs/architecture/pipeline.d2
#
# One estate's declaration-to-product flow and its local verification gates.
# Products are the nodes; a published contract is the only edge between two of
# them. Generation is depth, not a type. Rendered with:
#   d2 --layout elk docs/architecture/pipeline.d2 docs/architecture/pipeline.svg
# The committed SVG is generated from this source with the command above.

canvas: {
  label: ""
  style.fill: "#0d1117"
  style.stroke: "#0d1117"
  near: top-left
  direction: right

  inputs: {
    label: "declared inputs"
    class: container
    products: "declarations/products/\none document per product:\nlabel | sources | steps | target"
    sources: "declarations/\none document per source system:\nthe delivered schema and its landing"
    estate: "estate.yml + declarations/targets/\nlabels | adapters | expression mode\ntranslator table | budgets | boundaries"
    rules: "rules/\nthe estate's named-rule signatures"
  }

  engine: "ergasterion emit-products\nvalidate | plan | route | emit | gate"

  landing: "landing products\none per delivered source table\nprofile landing | shape declared"

  integration: "integration products\nconform, resolve identity, apply survivorship\nprofile integration | shape declared"

  consolidation: "consolidation products\nunion or merge two or more sources,\nreconcile coverage to the bases\nprofile consolidation"

  serving: {
    label: "serving products"
    class: container
    canonical: "shape canonical\none relation per published entity"
    dimensional: "shape dimensional\nfacts, dimensions and the semantic model"
    declared: "shape declared\nan aggregate the estate publishes"
  }

  published: {
    label: "published, from the same declarations"
    class: container
    models: "models/products/\ndbt models, schema documentation\nand every generated test"
    contracts: "contracts/products/\none ODCS contract per relation,\none ODPS descriptor per product"
    graph: "graphs/products/ + manifests/products/\nproduct and field lineage,\nthe runtime manifest per product"
  }

  gates: {
    label: "verification gates, offline"
    class: container
    byte_stable: "emit-products --check\nbyte-stable re-emission"
    dialect_lint: "ergasterion lint\nper-adapter dialect rules"
    structure: "ergasterion structure\nper-adapter structural budgets"
    target_parse: "dbt parse\nDuckDB and BigQuery"
    duckdb_build: "dbt build -t duckdb\nthe whole estate and its\nknown-answer assertions"
    acceptance: "validate_engine_architecture.sh\nthe thirteen acceptance checks"
  }

  inputs.products -> engine
  inputs.sources -> engine
  inputs.estate -> engine
  inputs.rules -> engine

  engine -> landing
  landing -> integration: "published contract"
  integration -> consolidation: "published contract"
  integration -> serving.canonical: "published contract"
  consolidation -> serving.dimensional: "published contract"
  consolidation -> serving.declared: "published contract"

  engine -> published.models
  engine -> published.contracts
  engine -> published.graph

  gates.byte_stable -> engine: {style.stroke-dash: 4}
  gates.dialect_lint -> published.models: {style.stroke-dash: 4}
  gates.structure -> published.models: {style.stroke-dash: 4}
  gates.target_parse -> published.models: {style.stroke-dash: 4}
  gates.duckdb_build -> serving: {style.stroke-dash: 4}
  gates.acceptance -> published.contracts: {style.stroke-dash: 4}
}

classes: {
  container: {
    style.fill: "#111820"
    style.stroke: "#21262d"
    style.font-color: "#8b949e"
    style.border-radius: 6
  }
}
