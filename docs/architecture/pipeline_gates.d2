# docs/architecture/pipeline_gates.d2
#
# Focused view of the offline verification gates shown in pipeline.d2. Every one
# of them runs without a warehouse account. Rendered with:
#   d2 --layout elk docs/architecture/pipeline_gates.d2 docs/architecture/pipeline_gates.svg
# The committed SVG is generated from this source with the command above.

canvas: {
  label: ""
  style.fill: "#0d1117"
  style.stroke: "#0d1117"
  near: top-left

  gates: {
    label: "verification gates, offline"
    class: container
    grid-columns: 2
    byte_stable: "emit-products --check\nbyte-stable re-emission"
    dialect_lint: "ergasterion lint\nper-adapter dialect rules"
    structure: "ergasterion structure\nper-adapter structural budgets"
    target_parse: "dbt parse\nDuckDB and BigQuery"
    duckdb_build: "dbt build -t duckdb\nthe whole estate and its\nknown-answer assertions"
    publication: "contract, descriptor and graph\ndrift checks"
  }
}

classes: {
  container: {
    style.fill: "#111820"
    style.stroke: "#21262d"
    style.font-color: "#8b949e"
    style.border-radius: 6
    style.font-size: 24
  }
  gate-lit: {
    style.fill: "#3fb950"
    style.stroke: "#56d364"
    style.font-color: "#0d1117"
    style.stroke-width: 2
    style.font-size: 28
  }
}

canvas.gates.byte_stable.class: gate-lit
canvas.gates.dialect_lint.class: gate-lit
canvas.gates.structure.class: gate-lit
canvas.gates.target_parse.class: gate-lit
canvas.gates.duckdb_build.class: gate-lit
canvas.gates.publication.class: gate-lit
