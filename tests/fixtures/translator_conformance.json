            "landing.validate",
            "landing.contract",
            "landing.schema",
            "landing.publish",
            "landing.lineage",
            "landing.metadata"
          ]
        },
        {
          "target_name": "rival_publisher",
          "owned_occurrences": ["landing.publish"],
          "execution_order": ["landing.publish"]
        }
      ]
    },
    {
      "id": "reordered_ownership",
      "description": "The translator's execution_order places landing.publish before landing.validate, landing.contract and landing.schema, violating their barrier edges into landing.publish.",
      "expected_error_code": "reordered_ownership",
      "translators": [
        {
          "target_name": "local_ingestion",
          "owned_occurrences": [
            "landing.checkpoint",
            "landing.ingest",
            "landing.validate",
            "landing.contract",
