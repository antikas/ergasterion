{
  "schema": "ergasterion.translator-conformance-vectors/v1",
  "description": "Data-only vectors for ergasterion/framework/translator_conformance.py. Each vector names a set of translator declarations and the router error code, or null for the positive case, that routing against the resolved Landing plan must produce. The seven occurrence-ownership vectors below carry no label/translator_table/adapters and exercise TranslationRouter's original routing mode unchanged; the three table_* vectors carry all three and exercise the two-axis capability router (architecture sections 9, 11; owner ruling R1; plan decision D29). See docs/architecture/landing-ingestion.md and tests/python/test_framework_core.py.",
  "vectors": [
    {
      "id": "valid_single_owner",
      "description": "One translator owns all eight Landing occurrences in a dependency-respecting execution order and pins no digest. The router routes cleanly with one assignment per occurrence.",
      "expected_error_code": null,
      "translators": [
        {
          "target_name": "local_ingestion",
          "owned_occurrences": [
            "landing.checkpoint",
            "landing.ingest",
            "landing.validate",
            "landing.contract",
            "landing.schema",
            "landing.publish",
            "landing.lineage",
            "landing.metadata"
          ],
          "execution_order": [
            "landing.checkpoint",
            "landing.ingest",
            "landing.validate",
            "landing.contract",
            "landing.schema",
            "landing.publish",
            "landing.lineage",
            "landing.metadata"
          ]
        }
      ]
    },
    {
      "id": "missing_execution_owner",
      "description": "The lone translator drops landing.metadata from its owned set: the occurrence requires an execution owner and gets none.",
      "expected_error_code": "missing_execution_owner",
      "translators": [
        {
          "target_name": "local_ingestion",
          "owned_occurrences": [
            "landing.checkpoint",
            "landing.ingest",
            "landing.validate",
            "landing.contract",
            "landing.schema",
            "landing.publish",
            "landing.lineage"
          ],
          "execution_order": [
            "landing.checkpoint",
            "landing.ingest",
            "landing.validate",
            "landing.contract",
            "landing.schema",
            "landing.publish",
            "landing.lineage"
          ]
        }
      ]
    },
    {
      "id": "duplicate_execution_owner",
      "description": "Two translators both claim landing.publish as execution owner.",
      "expected_error_code": "duplicate_execution_owner",
      "translators": [
        {
          "target_name": "local_ingestion",
          "owned_occurrences": [
            "landing.checkpoint",
            "landing.ingest",
            "landing.validate",
            "landing.contract",
