    },
    {
      "id": "digest_mismatch",
      "description": "The translator pins a plan_digest that does not equal the routed plan's computed digest -- it was built against a different (or stale) plan shape.",
      "expected_error_code": "digest_mismatch",
      "translators": [
        {
          "target_name": "local_ingestion",
          "owned_occurrences": [
