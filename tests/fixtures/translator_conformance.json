    {
      "id": "bad_handoff",
      "description": "The translator owns landing.publish but rejects the ergasterion.validation-result/v1 handoff schema carried on the landing.validate -> landing.publish barrier edge.",
      "expected_error_code": "bad_handoff",
      "translators": [
        {
          "target_name": "local_ingestion",
          "owned_occurrences": [
            "landing.checkpoint",
            "landing.ingest",
