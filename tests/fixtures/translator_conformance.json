      ]
    },
    {
      "id": "table_valid_two_translators_two_adapters",
      "description": "The real landing split as estate.yml's translator table declares it: local-ingestion owns the four runtime patterns and the publication translator owns the four publication-shaped patterns, all declared for both adapters. The router resolves all eight occurrences cleanly, two RouteAssignment rows each (one per adapter).",
      "expected_error_code": null,
      "label": "landing",
      "adapters": ["duckdb", "bigquery"],
      "translator_table": {
        "landing": {
          "batch_ingestion": "local-ingestion",
          "data_validation": "local-ingestion",
          "data_publish": "local-ingestion",
          "checkpoint_retries": "local-ingestion",
          "data_contracts": "publication",
          "schema_publish": "publication",
          "metadata_capture": "publication",
          "lineage_capture": "publication"
        }
      },
      "translators": [
        {
          "target_name": "local-ingestion",
          "capabilities": [
            ["batch_ingestion", "local-ingestion", "duckdb"],
            ["batch_ingestion", "local-ingestion", "bigquery"],
            ["data_validation", "local-ingestion", "duckdb"],
            ["data_validation", "local-ingestion", "bigquery"],
            ["data_publish", "local-ingestion", "duckdb"],
            ["data_publish", "local-ingestion", "bigquery"],
            ["checkpoint_retries", "local-ingestion", "duckdb"],
            ["checkpoint_retries", "local-ingestion", "bigquery"]
          ]
        },
        {
          "target_name": "publication",
          "capabilities": [
            ["data_contracts", "publication", "duckdb"],
            ["data_contracts", "publication", "bigquery"],
            ["schema_publish", "publication", "duckdb"],
            ["schema_publish", "publication", "bigquery"],
            ["metadata_capture", "publication", "duckdb"],
            ["metadata_capture", "publication", "bigquery"],
            ["lineage_capture", "publication", "duckdb"],
            ["lineage_capture", "publication", "bigquery"]
          ]
        }
      ]
    },
