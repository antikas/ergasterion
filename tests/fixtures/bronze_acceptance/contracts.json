     {
      "logical_type": "boolean",
      "value": true
     }
    ]
   },
   "quality": {
    "publication_mode": "all_or_nothing",
    "max_error_fraction": "0",
    "rules": [
     {
      "kind": "not_null",
      "field": "account_id",
      "severity": "error"
     },
     {
      "kind": "unique_key",
      "fields": [
       "account_id"
      ],
      "severity": "error"
     }
    ]
   },
   "retry": {
    "max_attempts": 4,
    "backoff": "exponential",
    "base_seconds": 5,
    "cap_seconds": 300
   }
  },
  "projection": [
   {
    "source": "account_id",
    "name": "account_id",
    "logical_type": "utf8_string",
    "nullable": false
   },
   {
    "source": "loaded_at",
    "name": "loaded_at",
    "logical_type": "utc_instant",
    "nullable": false
   }
