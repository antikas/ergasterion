with source as (
    select * from {{ ref('stg_toysrc_things') }}
),

alpha_res as (
    select * from {{ ref('res_alpha') }}
)

select
    source.source_id as source_id,
    source.alpha_name as alpha_name,
    source.alpha_code as alpha_code,
    source.as_of_ts as effective_from,
    alpha_res.golden_alpha_key as golden_alpha_key,
    alpha_res.golden_alpha_key as golden_beta_key
from source
inner join alpha_res
    on alpha_res.source_system = source.source_system
    and alpha_res.source_id = source.source_id
where alpha_res.golden_alpha_key is not null
    and {% if flags.FULL_REFRESH %}true{% else %}source.as_of_ts >= {{ dpf_window_floor('toysrc', 'things', 'as_of_ts', 1440, {'effective_column': 'effective_from', 'satellites': [{'relation': 'sat_alpha_toysrc', 'record_source': 'TOYSRC_ALPHA'}, {'relation': 'sat_beta_toysrc', 'record_source': 'TOYSRC_BETA'}]}) }}{% endif %}
