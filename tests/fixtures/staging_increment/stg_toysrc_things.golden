-- Generated by ergasterion/emit.py from declarations/*.yml. Do not edit by hand.
{{ config(
    materialized='incremental',
    incremental_strategy='delete+insert',
    unique_key=['source_id', 'as_of_ts'],
    on_schema_change='append_new_columns',
    incremental_predicates=[dpf_window_delete_predicate('toysrc', 'things', 'as_of_ts', '>=', 1440, {'effective_column': 'effective_from', 'satellites': [{'relation': 'sat_alpha_toysrc', 'record_source': 'TOYSRC_ALPHA'}, {'relation': 'sat_beta_toysrc', 'record_source': 'TOYSRC_BETA'}]})],
    post_hook=["{{ dpf_log_window_rows('toysrc', 'things', 'as_of_ts', 1440, {'effective_column': 'effective_from', 'satellites': [{'relation': 'sat_alpha_toysrc', 'record_source': 'TOYSRC_ALPHA'}, {'relation': 'sat_beta_toysrc', 'record_source': 'TOYSRC_BETA'}]}) }}"]
) }}
with source as (
    select * from {{ ref('raw_toysrc_things') }}
),

projected as (

select
    'toysrc' as source_system,
    cast(id as string) as source_id,
    cast(alpha_name as string) as alpha_name,
    cast(alpha_code as string) as alpha_code,
    cast(beta_name as string) as beta_name,
    cast(as_of_ts as timestamp) as as_of_ts
from source

)

select * from projected
{% if is_incremental() %}
where as_of_ts >= {{ dpf_window_floor('toysrc', 'things', 'as_of_ts', 1440, {'effective_column': 'effective_from', 'satellites': [{'relation': 'sat_alpha_toysrc', 'record_source': 'TOYSRC_ALPHA'}, {'relation': 'sat_beta_toysrc', 'record_source': 'TOYSRC_BETA'}]}) }}
{% endif %}
