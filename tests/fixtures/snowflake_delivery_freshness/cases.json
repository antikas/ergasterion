{
  "schema": "ergasterion.source-delivery-freshness-fixture/v1",
  "estate_namespace": "com.example.synthetic",
  "projection_target": "synth_target",
  "heartbeat_slo_seconds": 120,
  "maximum_age": {"warn_after_minutes": 90, "error_after_minutes": 180},
  "table": "accounts",
  "cases": [
    {
      "id": "fresh_ok",
      "native_freshness": true,
      "committed_offset_minutes": -30,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "projection_revision": 4,
      "expect_integrity": "pass",
      "expect_schedule": "pass",
      "expect_freshness": "pass"
    },
    {
      "id": "fresh_stale",
      "native_freshness": true,
      "committed_offset_minutes": -400,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "projection_revision": 4,
      "expect_integrity": "pass",
      "expect_schedule": "pass",
      "expect_freshness": "error"
    },
    {
      "id": "sched_late",
      "native_freshness": true,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "late",
      "row_digest": "match",
      "copies": 1,
      "projection_revision": 4,
      "expect_integrity": "pass",
      "expect_schedule": "fail",
      "expect_schedule_reason": "late",
      "expect_freshness": "pass"
    },
    {
      "id": "sched_only",
      "native_freshness": false,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "projection_revision": 2,
      "expect_integrity": "pass",
      "expect_schedule": "pass",
      "expect_freshness": "skip"
    },
    {
      "id": "fault_zero",
      "native_freshness": true,
      "copies": 0,
      "expect_integrity": "fail",
      "expect_integrity_reason": "missing_projection",
      "expect_schedule": "pass",
      "expect_freshness": "runtime_error"
    },
    {
      "id": "fault_dup",
      "native_freshness": true,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 2,
      "projection_revision": 3,
      "expect_integrity": "fail",
      "expect_integrity_reason": "duplicate_projection",
      "expect_schedule": "pass",
      "expect_freshness": "runtime_error"
    },
    {
      "id": "fault_digest",
      "native_freshness": true,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "wrong",
      "copies": 1,
      "projection_revision": 3,
      "expect_integrity": "fail",
      "expect_integrity_reason": "wrong_digest",
      "expect_schedule": "pass",
      "expect_freshness": "runtime_error"
    },
    {
      "id": "fault_null",
      "native_freshness": true,
      "committed_at": null,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "projection_revision": 3,
      "expect_integrity": "fail",
      "expect_integrity_reason": "null_committed_at",
      "expect_schedule": "pass",
      "expect_freshness": "runtime_error"
    },
    {
      "id": "fault_heartbeat",
      "native_freshness": true,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": -3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "projection_revision": 3,
      "expect_integrity": "fail",
      "expect_integrity_reason": "stale_heartbeat",
      "expect_schedule": "pass",
      "expect_freshness": "runtime_error"
    },
    {
      "id": "rev_lag",
      "native_freshness": true,
      "committed_offset_minutes": -25,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "projection_revision": 1,
      "expect_integrity": "pass",
      "expect_schedule": "pass",
      "expect_freshness": "pass",
      "note": "exact revision lag is an operator reconciliation test; dbt integrity ignores projection_revision"
    },
    {
      "id": "prior_digest_ok",
      "native_freshness": true,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "prior_digest_copies": 1,
      "projection_revision": 4,
      "expect_integrity": "pass",
      "expect_schedule": "pass",
      "expect_freshness": "pass",
      "note": "leftover prior-digest stream_status after carry/reset must not fail a single valid active row"
    },
    {
      "id": "fresh_extra_target_ok",
      "native_freshness": true,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "extra_target_copies": 1,
      "extra_projection_target": "other_target",
      "projection_revision": 4,
      "expect_integrity": "pass",
      "expect_schedule": "pass",
      "expect_freshness": "pass",
      "note": "a same-digest row for another projection_target must not fail the configured target"
    },
    {
      "id": "fault_wrong_target",
      "native_freshness": true,
      "committed_offset_minutes": -20,
      "heartbeat_offset_seconds": 3600,
      "timeliness": "on_time",
      "row_digest": "match",
      "copies": 1,
      "row_projection_target": "other_target",
      "projection_revision": 4,
      "expect_integrity": "fail",
      "expect_integrity_reason": "missing_projection",
      "expect_schedule": "pass",
      "expect_freshness": "runtime_error",
      "note": "no-args loaded_at_query must not treat a different projection_target as the configured projection"
    }
  ]
}
