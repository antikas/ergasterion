{
  "schema": "ergasterion.source-delivery-vectors/v1",
  "note": "Semantic (cross-field) vectors for ergasterion.source_delivery's mode matrix, codec rules, typed-scalar rules, schedule grammar and projection lineage. Every payload here is already a valid BronzeProductContract WIRE shape: it round-trips through ergasterion.framework.bronze_contract. Each negative entry states which semantic entry point rejects it: 'delivery' runs validate_delivery_policy against the delivery block alone, 'contract' runs validate_contract over the whole record. A patch key is a dotted path into the payload; its value replaces that node whole.",
  "positive": [
    {
      "case": "cdc_managed_explicit_tombstone",
      "note": "CDC mode: sequence progress, event and load timestamps, explicit_tombstone with a matching fingerprint scope, one nullable physical column, interval schedule.",
      "payload": {
        "schema": "ergasterion.bronze-product/v1",
        "logical_identity": {"estate_namespace": "com.example.ergasterion", "source": "acme", "table": "accounts"},
        "product": {
          "product_version": "1.0.0", "display_name": "Accounts", "description": "Synthetic accounts feed.",
          "owner": "team-data-platform", "domain": "operations", "support": "runbook-accounts",
          "classification": "synthetic", "access_policy_ref": "local-process-user", "retention_policy_ref": "local-ephemeral"
        },
        "landing": {
          "kind": "source", "source_name": "acme_accounts", "identifier": "accounts",
          "integration": {"kind": "managed"},
          "content_encodings": ["identity"],
          "codec": {"kind": "jsonl", "version": 1, "charset": "utf-8", "newline": "lf", "top_level": "object", "duplicate_keys": "reject", "number_mode": "exact_decimal", "allow_blank_lines": false},
          "physical_columns": [
            {"name": "account_id", "logical_type": "utf8_string", "nullable": false},
            {"name": "is_deleted", "logical_type": "boolean", "nullable": true},
            {"name": "seq", "logical_type": "int64", "nullable": false},
            {"name": "event_at", "logical_type": "utc_instant", "nullable": false},
            {"name": "loaded_at", "logical_type": "utc_instant", "nullable": false}
          ]
        },
        "delivery": {
          "kind": "production", "mode": "cdc",
          "progress": {"kind": "sequence", "field": "seq"},
          "delete_strategy": "explicit_tombstone",
          "schedule": {"kind": "interval", "every_minutes": 15, "anchor_at": "2026-01-01T00:00:00.000000Z"},
          "schedule_lateness": {"warn_after_minutes": 15, "error_after_minutes": 60},
          "timestamps": {"load_field": "loaded_at", "event_field": "event_at"},
          "record_key": {
            "fields": ["account_id"],
            "fingerprint_scope": {"scope_id": "accounts_scope", "scope_parameters": {}},
            "hmac_key_id": "hmac-key-1"
          },
          "tombstone": {"field": "is_deleted", "values": [{"logical_type": "boolean", "value": true}]},
          "quality": {"publication_mode": "all_or_nothing", "max_error_fraction": "0", "rules": [
            {"kind": "not_null", "field": "account_id", "severity": "error"},
            {"kind": "unique_key", "fields": ["account_id"], "severity": "error"}
          ]},
          "retry": {"max_attempts": 4, "backoff": "exponential", "base_seconds": 5, "cap_seconds": 300}
        },
        "projection": [
          {"source": "account_id", "name": "account_id", "logical_type": "utf8_string", "nullable": false},
          {"source": "loaded_at", "name": "loaded_at", "logical_type": "utc_instant", "nullable": false}
        ],
        "interfaces": {"raw": "bronze-acme-accounts-raw", "source_native": "bronze-acme-accounts-source-native", "published": "bronze-acme-accounts-published", "quarantine": "bronze-acme-accounts-quarantine", "deletion_evidence": "bronze-acme-accounts-deletion-evidence"}
      }
    },
    {
      "case": "append_only_managed_opaque_batch",
      "note": "Append-only mode: opaque_batch progress, delete_strategy none, load timestamp only, publish_valid_rows, both content encodings admitted.",
      "payload": {
        "schema": "ergasterion.bronze-product/v1",
        "logical_identity": {"estate_namespace": "com.example.ergasterion", "source": "acme", "table": "orders"},
        "product": {
          "product_version": "1.0.0", "display_name": "Orders", "description": "Synthetic source-aligned orders.",
          "owner": "team-data-platform", "domain": "operations", "support": "runbook-orders",
