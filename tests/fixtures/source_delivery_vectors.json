    {"case": "cron_expression_wrong_field_count", "validator": "delivery", "note": "the v1 cron grammar has exactly five fields.", "base": "csv_external_append_only", "patch": {"delivery.schedule": {"kind": "cron", "expression": "0 30 2 * * 1-5", "timezone": "Europe/London", "starts_at": "2026-01-01T00:00:00.000000Z", "timezone_data_version": "2026.2"}}, "expected_error_substring": "exactly five fields"},
